{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "vite.demo.config.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "capacitor.config.ts",
    "tools/demo-build/**/*.ts"
  ]
}
